  turntable: {fileID: 252103090}
  targetCamera: {fileID: 1776357959}
  autoFrame: 0
  turnSpeed: 14
  switchEvery: 7
  birdLabel: Starling
  flyClip: {fileID: -2775830064690490884, guid: 3b7a55cc48314483d99e566b7c5c351c, type: 3}
  glideClip: {fileID: 1399976607119397091, guid: 3b7a55cc48314483d99e566b7c5c351c, type: 3}
  flyState: Maeko_Fly
  glideState: Maeko_Glide
  flyDescription: "Maeko_Fly \xB7 the flap cycle. Plays whenever a bird cruises,
    climbs, or panics. In the flock, its speed is synced to each bird's airspeed,
    so fast birds flap faster."
  glideDescription: "Maeko_Glide \xB7 the wings-out soar. The flock cuts to it automatically
    during dives, steady descents, and short bounding-flight pulses, then blends
    back to the flap."
